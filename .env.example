# Public production HTTPS origin; required for sitemap/canonicals and indexing.
VITE_SITE_URL=https://your-real-domain.com
# Optional public POST endpoint. Never put a secret in a VITE_ variable.
# Leave unset until delivery, privacy terms and abuse protection are configured/tested.
# VITE_REQUEST_ENDPOINT=https://your-backend.example.com/requests

# Optional project subpath for GitHub Pages; default is /.
# VITE_BASE_PATH=/cali-vehicle-detailing/
